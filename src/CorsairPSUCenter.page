Menu="Tasks:75"
Title="Corsair PSU"
Icon="corsairpsucenter.png"
---
<style>
/* Everything below is sized in em relative to #cpc's own font-size, so the
   whole app scales from one number. --cpc-scale is set from the A-/A+ buttons
   and remembered in localStorage. */
#cpc { --cpc-scale:1;
       font-size:calc(15px * var(--cpc-scale));
       background:#16181d; color:#e8eaed; border-radius:6px; padding:0; margin:-12px 0 0 0;
       font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; overflow:hidden; }
#cpc * { box-sizing:border-box; }
.cpc-top { display:flex; align-items:center; gap:1em; padding:1em 1.2em;
           background:#1b1e24; border-bottom:1px solid #2a2f38; }
.cpc-top .name { font-size:1.25em; font-weight:600; letter-spacing:.5px; }
.cpc-dot { width:.65em; height:.65em; border-radius:50%; background:#6fc26f; display:inline-block; flex:none; }
.cpc-dot.off { background:#d05353; }
.cpc-top .spacer { flex:1; }
.cpc-top .big { font-size:1.9em; font-weight:600; color:#f0c040; line-height:1.1; }
.cpc-top .sub { font-size:.8em; color:#8a9099; text-transform:uppercase; letter-spacing:1px; }
.cpc-mains { display:flex; align-items:center; gap:.4em; margin-left:1.4em; }
.cpc-mains .cpc-mains-lbl { font-size:.7em; text-transform:uppercase; letter-spacing:1.2px; color:#8a9099; margin-right:.15em; }
.cpc-mains .cpc-btn.cpc-mini { margin:0; padding:.32em .62em; font-size:.78em; }
.cpc-zoom button { background:#2a2f38; color:#e8eaed; border:1px solid #39404b; border-radius:4px;
                   width:2.1em; height:2.1em; cursor:pointer; font-size:1em; margin-left:.25em; }
.cpc-zoom button:hover { background:#39404b; }
.cpc-body { display:flex; gap:1em; padding:1em; align-items:flex-start; }
.cpc-side { width:17em; flex:none; }
.cpc-main { flex:1; min-width:0; }
.cpc-card { background:#1b1e24; border:1px solid #2a2f38; border-radius:5px; padding:.9em; margin-bottom:.9em; }
.cpc-card h3 { margin:0 0 .7em 0; font-size:.85em; text-transform:uppercase; letter-spacing:1.2px;
               color:#9aa0a8; font-weight:600; }
/* auto-fit means bigger scale => fewer, wider tiles automatically */
.cpc-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(15.5em,1fr)); gap:.55em; }
.tile { display:flex; background:#2a2f38; border-radius:4px; overflow:hidden; min-height:6.4em; }
.tile .vbox { background:#22262e; padding:.65em .8em 0 .8em; width:58%; position:relative; display:flex;
              flex-direction:column; justify-content:flex-start; }
.tile .val { font-size:1.85em; font-weight:600; line-height:1.1; white-space:nowrap; }
.tile .val .u { font-size:.5em; font-weight:400; color:#8a9099; margin-left:.3em; }
/* the small secondary numbers (min/max on sensor tiles, cost on energy tiles):
   one uniform, readable size across every tile. Kept just under the main value
   and non-wrapping; the min/max pair is the width-limiting case. */
.tile .mm { font-size:1.05em; color:#9aa0a8; margin-top:.28em; white-space:nowrap; font-variant-numeric:tabular-nums; }
.tile .eval2 { font-size:1.05em; font-weight:600; color:#6fc26f; margin-top:.24em; line-height:1.15;
               white-space:nowrap; font-variant-numeric:tabular-nums; }
.tile .eval2.zero { color:#7a8089; font-weight:400; }
.tile .spark { position:absolute; left:0; bottom:0; width:100%; height:1.7em; display:block; }
.tile .lbl { padding:.65em .8em; font-size:1em; color:#d2d6dc; display:flex; align-items:center; }
.cpc-btn { background:#2a2f38; color:#e8eaed; border:1px solid #39404b; border-radius:4px;
           padding:.45em .9em; cursor:pointer; font-size:.9em; margin:0 .45em .45em 0; }
.cpc-btn:hover { background:#333944; }
.cpc-btn.active { background:#f0c040; color:#16181d; border-color:#f0c040; font-weight:600; }
.cpc-preset { display:block; width:100%; text-align:left; background:#22262e; color:#c8ccd2;
              border:1px solid #2a2f38; border-radius:4px; padding:.55em .75em; margin-bottom:.35em;
              cursor:pointer; font-size:.92em; }
.cpc-preset:hover { background:#2a2f38; }
.cpc-preset.active { background:#f0c040; color:#16181d; font-weight:600; border-color:#f0c040; }
.cpc-row { display:flex; justify-content:space-between; font-size:.95em; padding:.25em 0; color:#b2b8c0; }
.cpc-row b { color:#e8eaed; font-weight:600; }
#curveSvg { width:100%; height:20em; display:block; touch-action:none; }
#curveSvg circle.pt { fill:#fff; stroke:#f0c040; stroke-width:2; cursor:grab; }
#curveSvg circle.pt:hover { fill:#f0c040; }
.cpc-note { font-size:.82em; color:#7c828b; margin-top:.6em; line-height:1.5; }
.cpc-msg { font-size:.88em; padding:.5em .75em; border-radius:4px; margin-top:.6em; display:none; }
.cpc-msg.ok { background:#1e3a24; color:#8fd18f; display:block; }
.cpc-msg.err { background:#3a1e1e; color:#e08585; display:block; }
.cpc-slider { width:100%; margin:.5em 0; }
/* energy history - built from divs, NOT a <table>: Unraid's global table theme
   forces a light background that hid the light text. */
.cpc-hist { font-size:.95em; }
.cpc-hrow { display:flex; align-items:center; padding:.5em .25em; border-bottom:1px solid #23272f; }
.cpc-hrow:last-child { border-bottom:none; }
.cpc-hhead { border-bottom:1px solid #2a2f38; }
.cpc-hc-label { flex:1; color:#d2d6dc; }
.cpc-hc-num { width:8em; text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; color:#d2d6dc; }
.cpc-hc-num.cost { color:#6fc26f; }
.cpc-hhead .cpc-hc-label, .cpc-hhead .cpc-hc-num { color:#9aa0a8; font-size:.8em; font-weight:600;
               text-transform:uppercase; letter-spacing:.6px; }
.cpc-hrow.empty { color:#7c828b; justify-content:center; }
.cpc-histfilter { margin-bottom:.7em; }
/* pick any specific month / year */
.cpc-pick { margin-bottom:1em; }
.cpc-pickrow { display:flex; align-items:center; gap:.7em; margin-bottom:.55em; flex-wrap:wrap; }
.cpc-pickrow > label { font-size:.72em; text-transform:uppercase; letter-spacing:.8px; color:#8a9099; width:3.4em; flex:none; }
.cpc-select { background:#22262e; color:#e8eaed; border:1px solid #39404b; border-radius:4px;
              padding:.4em .6em; font-size:.95em; cursor:pointer; min-width:11em; }
.cpc-select:hover { border-color:#4a525f; }
/* Unraid's theme has a select:focus rule that flips the box white; that hid the
   light text while focused (right after picking). Pin dark on every state. */
.cpc-select:focus, .cpc-select:focus-visible, .cpc-select:active {
              background:#22262e !important; color:#e8eaed !important; outline:none; border-color:#f0c040; }
.cpc-select option { background:#22262e; color:#e8eaed; }
.cpc-pickres { font-size:1.2em; font-weight:600; font-variant-numeric:tabular-nums; white-space:nowrap; }
.cpc-pickres .pk-k { color:#f0c040; }
.cpc-pickres .pk-c { color:#6fc26f; margin-left:.55em; }
/* currency card */
.cpc-cur-input { width:100%; background:#22262e; color:#e8eaed; border:1px solid #39404b; border-radius:4px;
                 padding:.4em .6em; font-size:.95em; margin-bottom:.55em; }
.cpc-cur-input:focus { outline:none; border-color:#f0c040; background:#22262e; color:#e8eaed; }
</style>

<div id="cpc">
  <div class="cpc-top">
    <span class="cpc-dot" id="dot"></span>
    <span class="name" id="devname">CORSAIR HX1000i</span>
    <div class="cpc-mains" title="Leave on Auto to read input voltage from the PSU. A few units (e.g. the HX1000i 2022 revision) misreport input voltage at about double the real value; if yours shows ~230 V on a 115 V outlet (or the reverse), pin your real mains here so the efficiency and power-in estimates stay correct.">
      <span class="cpc-mains-lbl">Mains</span>
      <button class="cpc-btn cpc-mini" id="mainsAuto">Auto</button>
      <button class="cpc-btn cpc-mini" id="mains115">115V</button>
      <button class="cpc-btn cpc-mini" id="mains230">230V</button>
    </div>
    <span class="spacer"></span>
    <div class="cpc-zoom" title="Text size">
      <button id="zOut">&minus;</button><button id="zRst">A</button><button id="zIn">+</button>
    </div>
    <div style="text-align:right">
      <div class="big"><span id="topLoad">--</span> W</div>
      <div class="sub">Total Draw <span id="topCap"></span></div>
    </div>
  </div>

  <div class="cpc-body">
    <div class="cpc-side">
      <div class="cpc-card">
        <h3>Device</h3>
        <div class="cpc-row"><span>Status</span><b id="sStatus">--</b></div>
        <div class="cpc-row"><span>Input</span><b id="sInput">--</b></div>
        <div class="cpc-row"><span>Efficiency</span><b id="sEff">--</b></div>
        <div class="cpc-row"><span>Fan</span><b id="sFan">--</b></div>
        <div class="cpc-row"><span>Fan mode</span><b id="sMode">--</b></div>
      </div>

      <div class="cpc-card">
        <h3>Cooling Presets</h3>
        <button class="cpc-preset" data-preset="auto">Default (PSU controlled)</button>
        <button class="cpc-preset" data-preset="quiet">Quiet</button>
        <button class="cpc-preset" data-preset="balanced">Balanced</button>
        <button class="cpc-preset" data-preset="performance">Performance</button>
        <button class="cpc-preset" data-preset="fixed">Fixed</button>
        <button class="cpc-preset" data-preset="customcurve">Custom Curve</button>
      </div>

      <div class="cpc-card">
        <h3>+12V OCP Rail Mode</h3>
        <button class="cpc-btn" id="ocpSingle">Single Rail</button>
        <button class="cpc-btn" id="ocpMulti">Multi Rail</button>
        <div class="cpc-row"><span>Last set</span><b id="sOcp">--</b></div>
        <div class="cpc-note">Single rail uses one combined overcurrent threshold for the whole +12V
        output &mdash; fewer nuisance trips when several drives spin up together. Multi rail (factory
        default) protects each output group separately.</div>
      </div>

      <div class="cpc-card">
        <h3>Currency</h3>
        <select class="cpc-select" id="curSelect" style="width:100%;min-width:0;margin-bottom:.55em"></select>
        <input type="text" id="curCustom" class="cpc-cur-input" maxlength="4" placeholder="Symbol, e.g. Fr" hidden>
        <div style="margin-bottom:.4em">
          <button class="cpc-btn" id="curBefore">Before $1</button>
          <button class="cpc-btn" id="curAfter">After 1&#8201;&euro;</button>
        </div>
        <div class="cpc-row"><span>Example</span><b id="curPreview">$0.15</b></div>
        <div class="cpc-note">Pick a currency, or choose Custom to type any symbol. Placement sets whether the
        symbol sits before the amount ($1) or after it (1&#8201;&euro;).</div>
      </div>
    </div>

    <div class="cpc-main">
      <div class="cpc-grid" id="tiles"></div>

      <div class="cpc-card" id="histCard" style="margin-top:12px">
        <h3>Energy History</h3>
        <div class="cpc-pick">
          <div class="cpc-pickrow">
            <label>Month</label>
            <select class="cpc-select" id="monthPick"></select>
            <span class="cpc-pickres" id="monthPickRes">&mdash;</span>
          </div>
          <div class="cpc-pickrow">
            <label>Year</label>
            <select class="cpc-select" id="yearPick"></select>
            <span class="cpc-pickres" id="yearPickRes">&mdash;</span>
          </div>
        </div>
        <div class="cpc-histfilter" id="histFilter">
          <button class="cpc-btn" data-n="1">1 Month</button>
          <button class="cpc-btn" data-n="3">3 Months</button>
          <button class="cpc-btn" data-n="6">6 Months</button>
          <button class="cpc-btn" data-n="12">12 Months</button>
          <button class="cpc-btn active" data-n="0">All</button>
        </div>
        <div class="cpc-hist" id="histMonths">
          <div class="cpc-hrow cpc-hhead"><span class="cpc-hc-label">Month</span><span class="cpc-hc-num">Energy</span><span class="cpc-hc-num">Cost</span></div>
          <div id="histBodyM"></div>
        </div>
        <h3 style="margin-top:1.1em">By Year</h3>
        <div class="cpc-hist" id="histYears">
          <div class="cpc-hrow cpc-hhead"><span class="cpc-hc-label">Year</span><span class="cpc-hc-num">Energy</span><span class="cpc-hc-num">Cost</span></div>
          <div id="histBodyY"></div>
        </div>
        <div class="cpc-note">Past months are kept for good (a few bytes each). The current month fills in
        live and drops into the list once it rolls over. Days the server was off are not counted.</div>
      </div>

      <div class="cpc-card" style="margin-top:12px">
        <h3>Fan Control</h3>
        <div id="fixedBox" style="display:none">
          <input type="range" min="30" max="100" value="40" class="cpc-slider" id="fixedSlider">
          <div class="cpc-row"><span>Fixed duty</span><b><span id="fixedVal">40</span>%</b></div>
          <button class="cpc-btn" id="applyFixed">Apply Fixed Speed</button>
        </div>
        <div id="curveBox" style="display:none">
          <svg id="curveSvg" viewBox="0 0 660 270" preserveAspectRatio="none"></svg>
          <button class="cpc-btn" id="applyCurve">Apply Curve</button>
          <span style="font-size:.75rem;color:#8a9099">Drag the points. X = VRM temperature, Y = fan duty.</span>
        </div>
        <div class="cpc-note" id="fanNote"></div>
        <div class="cpc-msg" id="msg"></div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
const API = '/plugins/corsairpsucenter/api.php';

const TILES = [
  {k:'fan_rpm',   l:'Fan',            u:'RPM', c:'#6fa8dc', d:0},
  {k:'efficiency',l:'Efficiency',     u:'%',   c:'#6fc26f', d:1},
  {k:'temp_vrm',  l:'VRM Temp',       u:'°C', c:'#e0904a', d:2},
  {k:'temp_case', l:'Case Temp',      u:'°C', c:'#e0904a', d:1},
  {k:'power_in',  l:'Power In',       u:'W',   c:'#b98ee6', d:0},
  {k:'power_out', l:'Power Out',      u:'W',   c:'#b98ee6', d:0},
  {k:'v_in',      l:'Input Voltage',  u:'V',   c:'#b98ee6', d:1},
  {k:'load_pct',  l:'Load',           u:'%',   c:'#6fc26f', d:1},
  {k:'v_12',      l:'12V Voltage',    u:'V',   c:'#b98ee6', d:2},
  {k:'c_12',      l:'12V Current',    u:'A',   c:'#b98ee6', d:2},
  {k:'p_12',      l:'12V Power',      u:'W',   c:'#b98ee6', d:0},
  {k:'v_5',       l:'5V Voltage',     u:'V',   c:'#b98ee6', d:2},
  {k:'c_5',       l:'5V Current',     u:'A',   c:'#b98ee6', d:2},
  {k:'p_5',       l:'5V Power',       u:'W',   c:'#b98ee6', d:1},
  {k:'v_33',      l:'3.3V Voltage',   u:'V',   c:'#b98ee6', d:2},
  {k:'c_33',      l:'3.3V Current',   u:'A',   c:'#b98ee6', d:2},
  {k:'p_33',      l:'3.3V Power',     u:'W',   c:'#b98ee6', d:1}
];

const PRESETS = {
  auto:        null,
  quiet:       '20,30 50,30 65,40 80,60 90,85',
  balanced:    '20,30 45,35 60,55 75,75 90,100',
  performance: '20,40 40,55 55,75 70,90 85,100',
  max:         '20,100 100,100'
};

const HIST = {}, MIN = {}, MAX = {};
TILES.forEach(t => { HIST[t.k] = []; });

// energy tiles (cumulative usage + cost) - appended into the same grid, so they
// read as more tiles rather than a separate section.
const ETILES = [
  {k:'today', l:'Today'}, {k:'week', l:'This Week'}, {k:'month', l:'This Month'},
  {k:'last_month', l:'Last Month'}, {k:'year', l:'This Year'}, {k:'lifetime', l:'Lifetime'}
];
let lastRate = 0, lastCur = '$', lastPos = 'before';
const CURRENCIES = [
  {sym:'$',  label:'$   US Dollar',         pos:'before'},
  {sym:'€',  label:'€   Euro',              pos:'after'},
  {sym:'£',  label:'£   British Pound',     pos:'before'},
  {sym:'¥',  label:'¥   Yen / Yuan',        pos:'before'},
  {sym:'kr', label:'kr  Krona / Krone',     pos:'after'},
  {sym:'C$', label:'C$  Canadian Dollar',   pos:'before'},
  {sym:'A$', label:'A$  Australian Dollar', pos:'before'},
  {sym:'R$', label:'R$  Brazilian Real',    pos:'before'},
  {sym:'zł', label:'zł  Polish Zloty',      pos:'after'},
  {sym:'__custom__', label:'Custom…',       pos:null}
];
let histMonths = [], histYears = [], histN = 0;
let pickYm = null, pickYear = null, pickSig = '';

// build tiles
const grid = document.getElementById('tiles');
grid.innerHTML = TILES.map(t => `
  <div class="tile">
    <div class="vbox">
      <div class="val" style="color:${t.c}"><span id="v_${t.k}">--</span><span class="u">${t.u}</span></div>
      <div class="mm">&darr; <span id="lo_${t.k}">--</span> &nbsp; &uarr; <span id="hi_${t.k}">--</span></div>
      <svg class="spark" id="sp_${t.k}" viewBox="0 0 100 24" preserveAspectRatio="none">
        <polyline fill="none" stroke="${t.c}" stroke-width="1.4" points=""/>
      </svg>
    </div>
    <div class="lbl">${t.l}</div>
  </div>`).join('');

// append the energy tiles (same tile styling, no sparkline)
grid.innerHTML += ETILES.map(t => `
  <div class="tile etile">
    <div class="vbox">
      <div class="val" style="color:#f0c040"><span id="ek_${t.k}">--</span><span class="u">kWh</span></div>
      <div class="eval2"><span id="ec_${t.k}">--</span></div>
    </div>
    <div class="lbl">${t.l}</div>
  </div>`).join('') + `
  <div class="tile etile" id="rateTile" style="cursor:pointer" title="Set your electricity rate">
    <div class="vbox">
      <div class="val" style="color:#6fc26f"><span id="e_rate">--</span><span class="u">/kWh</span></div>
      <div class="mm">click to set rate</div>
    </div>
    <div class="lbl">Rate</div>
  </div>
  <div class="tile etile" id="resetTile" style="cursor:pointer" title="Reset energy counters">
    <div class="vbox">
      <div class="val" style="color:#8a9099;font-size:1.15em"><span id="e_since">--</span></div>
      <div class="mm">tracking since</div>
      <div class="mm">click to reset</div>
    </div>
    <div class="lbl">Reset</div>
  </div>`;

function spark(k){
  const h = HIST[k]; if (h.length < 2) return;
  let lo = Math.min(...h), hi = Math.max(...h);
  if (hi - lo < 1e-9) { hi = lo + 1; }
  const n = h.length;
  const pts = h.map((v,i) => {
    const x = (i/(n-1))*100;
    const y = 23 - ((v-lo)/(hi-lo))*21;
    return x.toFixed(1)+','+y.toFixed(1);
  }).join(' ');
  document.querySelector('#sp_'+k+' polyline').setAttribute('points', pts);
}

let cfgMode = 'auto', curvePts = [], fixedDirty = false;

function setModeButtons(m){
  // Fan modes now live in the Cooling Presets list; this just reveals the matching
  // editor (slider for Fixed, curve canvas for Custom) in the Fan Control card.
  document.getElementById('fixedBox').style.display = (m==='fixed') ? 'block':'none';
  document.getElementById('curveBox').style.display = (m==='curve') ? 'block':'none';
}

function setMainsButtons(m){
  document.getElementById('mainsAuto').classList.toggle('active', m==='auto');
  document.getElementById('mains115').classList.toggle('active', m==='115');
  document.getElementById('mains230').classList.toggle('active', m==='230');
}

// A preset (Quiet/Balanced/Performance) is applied as a curve, so the stored mode
// is just "curve". Match the active curve back to the preset that produced it so
// the Fan mode line names it instead of the generic "Custom curve". A hand-dragged
// curve matches nothing -> stays "Custom curve". (Default/Fixed/Max are unchanged.)
function curveName(curveStr){
  const names = { quiet:'Quiet', balanced:'Balanced', performance:'Performance' };
  for (const k in names) if (PRESETS[k] === curveStr) return names[k];
  return 'Custom curve';
}

function refresh(){
  fetch(API+'?action=status').then(r=>r.json()).then(s=>{
    const dot = document.getElementById('dot');
    if (!s.connected){ dot.className='cpc-dot off'; document.getElementById('sStatus').textContent='Not found'; return; }
    dot.className='cpc-dot';
    const f = (v,d)=> (v===null||v===undefined) ? '--' : Number(v).toFixed(d);
    document.getElementById('devname').textContent = s.model;
    document.getElementById('topLoad').textContent = f(s.power_out,0);
    document.getElementById('topCap').textContent  =
      (s.capacity && s.load_pct!==null) ? ('· '+f(s.load_pct,1)+'% of '+s.capacity+' W') : '';
    document.getElementById('sStatus').textContent = s.known ? 'Connected' : 'Connected (unrecognised model)';
    document.getElementById('sInput').textContent  = f(s.v_in,0)+' V';
    document.getElementById('sEff').textContent    = s.efficiency===null ? 'n/a' : f(s.efficiency,1)+' %';
    document.getElementById('sFan').textContent    = f(s.fan_rpm,0)+' RPM';
    document.getElementById('sMode').textContent   =
      s.fan_mode==='auto' ? 'Default' : (s.fan_mode==='fixed' ? 'Fixed '+s.fan_fixed+'%' : curveName(s.fan_curve));
    document.getElementById('sOcp').textContent    = s.ocp_mode;
    setMainsButtons(s.mains||'auto');

    TILES.forEach(t=>{
      const v = s[t.k];
      // efficiency/power_in/load are null on an unrecognised model - show n/a
      // rather than a stale or invented number
      if (v===null||v===undefined){ document.getElementById('v_'+t.k).textContent='n/a'; return; }
      document.getElementById('v_'+t.k).textContent = Number(v).toFixed(t.d);
      MIN[t.k] = (MIN[t.k]===undefined)? v : Math.min(MIN[t.k], v);
      MAX[t.k] = (MAX[t.k]===undefined)? v : Math.max(MAX[t.k], v);
      document.getElementById('lo_'+t.k).textContent = Number(MIN[t.k]).toFixed(t.d);
      document.getElementById('hi_'+t.k).textContent = Number(MAX[t.k]).toFixed(t.d);
      HIST[t.k].push(v); if (HIST[t.k].length>60) HIST[t.k].shift();
      spark(t.k);
    });

    if (cfgMode === null || cfgMode === undefined) cfgMode = s.fan_mode;
    if (!curvePts.length) { curvePts = parseCurve(s.fan_curve); drawCurve(); }
    // Don't yank the slider out from under the user while they're dragging it -
    // only sync it from the server when they aren't mid-adjustment (fixedDirty).
    if (!fixedDirty) {
      document.getElementById('fixedSlider').value = s.fan_fixed;
      document.getElementById('fixedVal').textContent = s.fan_fixed;
    }
    document.getElementById('fanNote').textContent = s.fan_mode==='curve'
      ? ('Curve service '+(s.daemon?'running':'NOT running')+' — duty is re-applied from VRM temperature every 10s.')
      : 'The PSU cannot store a curve in firmware, so custom curves are driven from Unraid (same as iCUE does on Windows). Minimum duty is 30%.';
  }).catch(()=>{});
}

// ---- curve editor ----
const X0=46, X1=600, Y0=236, Y1=18, TMIN=20, TMAX=100;
function tx(t){ return X0 + (t-TMIN)/(TMAX-TMIN)*(X1-X0); }
function ty(d){ return Y0 - (d/100)*(Y0-Y1); }
function xt(x){ return Math.round(TMIN + (x-X0)/(X1-X0)*(TMAX-TMIN)); }
function yd(y){ return Math.round((Y0-y)/(Y0-Y1)*100); }
function parseCurve(s){
  return (s||'').trim().split(/\s+/).map(p=>{
    const a=p.split(','); return {t:+a[0], d:+a[1]};
  }).filter(p=>!isNaN(p.t)&&!isNaN(p.d)).sort((a,b)=>a.t-b.t);
}
function drawCurve(){
  const svg = document.getElementById('curveSvg');
  let h = '';
  h += `<rect x="${X0}" y="${Y1}" width="${X1-X0}" height="${Y0-Y1}" fill="#14161a"/>`;
  h += `<rect x="${X0}" y="${ty(30)}" width="${X1-X0}" height="${Y0-ty(30)}" fill="#2a1a1a"/>`;
  for(let d=0; d<=100; d+=25){
    h += `<line x1="${X0}" y1="${ty(d)}" x2="${X1}" y2="${ty(d)}" stroke="#262b33"/>`;
    h += `<text x="${X1+6}" y="${ty(d)+4}" fill="#6c727b" font-size="10">${d}%</text>`;
  }
  for(let t=TMIN; t<=TMAX; t+=10){
    h += `<line x1="${tx(t)}" y1="${Y1}" x2="${tx(t)}" y2="${Y0}" stroke="#262b33"/>`;
    h += `<text x="${tx(t)}" y="${Y0+16}" fill="#6c727b" font-size="10" text-anchor="middle">${t}°</text>`;
  }
  h += `<text x="${X0-6}" y="${ty(30)+4}" fill="#8a5a5a" font-size="9" text-anchor="end">min</text>`;
  if (curvePts.length){
    // The daemon clamps outside the end points, so draw the curve flat out to
    // both edges - otherwise the chart implies the fan stops past the last point.
    const first = curvePts[0], last = curvePts[curvePts.length-1];
    const line = [`${X0},${ty(first.d)}`]
      .concat(curvePts.map(p=>`${tx(p.t)},${ty(p.d)}`))
      .concat([`${X1},${ty(last.d)}`]).join(' ');
    h += `<polygon points="${X0},${Y0} ${line} ${X1},${Y0}" fill="#f0c04022"/>`;
    h += `<polyline points="${line}" fill="none" stroke="#f0c040" stroke-width="2"/>`;
    curvePts.forEach((p,i)=>{
      h += `<circle class="pt" data-i="${i}" cx="${tx(p.t)}" cy="${ty(p.d)}" r="6"/>`;
    });
  }
  svg.innerHTML = h;
  svg.querySelectorAll('circle.pt').forEach(c=>{
    c.addEventListener('mousedown', startDrag);
  });
}
let dragIdx=null;
function startDrag(e){ dragIdx = +e.target.dataset.i; e.preventDefault(); }
document.addEventListener('mousemove', e=>{
  if (dragIdx===null) return;
  const svg=document.getElementById('curveSvg'), r=svg.getBoundingClientRect();
  const sx=(e.clientX-r.left)/r.width*660, sy=(e.clientY-r.top)/r.height*270;
  let t=xt(sx), d=yd(sy);
  t=Math.max(TMIN,Math.min(TMAX,t)); d=Math.max(30,Math.min(100,d));
  const prev=curvePts[dragIdx-1], next=curvePts[dragIdx+1];
  if(prev) t=Math.max(t,prev.t+1);
  if(next) t=Math.min(t,next.t-1);
  curvePts[dragIdx]={t:t,d:d};
  drawCurve();
});
document.addEventListener('mouseup', ()=>{ dragIdx=null; });

function msg(ok,txt){
  const m=document.getElementById('msg');
  m.className='cpc-msg '+(ok?'ok':'err');
  m.textContent=txt;
  setTimeout(()=>{ m.className='cpc-msg'; }, 6000);
}
function post(params){
  // Unraid rejects POSTs to plugin endpoints without its CSRF token.
  // csrf_token is a global provided by the webGui on every page.
  params.csrf_token = (typeof csrf_token !== 'undefined') ? csrf_token : '';
  return fetch(API, {method:'POST', credentials:'same-origin',
    headers:{'Content-Type':'application/x-www-form-urlencoded'},
    body:new URLSearchParams(params)}).then(r=>r.text()).then(t=>{
      try { return JSON.parse(t); }
      catch(e){ return {ok:false, output:'Bad response from server: '+t.slice(0,200)}; }
    });
}

// Fan modes are driven entirely from the Cooling Presets list (.cpc-preset handler below).

document.getElementById('fixedSlider').oninput = e=>{ fixedDirty = true; document.getElementById('fixedVal').textContent=e.target.value; };
document.getElementById('applyFixed').onclick = ()=>{
  const d=document.getElementById('fixedSlider').value;
  post({action:'setfanmode',mode:'fixed',fixed:d}).then(r=>{ fixedDirty=false; msg(r.ok, r.ok?('Fan set to '+d+'%.'):r.output); refresh(); });
};
document.getElementById('applyCurve').onclick = ()=>{
  const c=curvePts.map(p=>p.t+','+p.d).join(' ');
  post({action:'setfanmode',mode:'curve',curve:c}).then(r=>{ msg(r.ok, r.ok?'Curve applied and service started.':r.output); refresh(); });
};
document.querySelectorAll('.cpc-preset').forEach(b=>{
  b.onclick = ()=>{
    document.querySelectorAll('.cpc-preset').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    const p=b.dataset.preset;
    if (p==='auto'){ cfgMode='auto'; setModeButtons('auto');
      post({action:'setfanmode',mode:'auto'}).then(r=>{ msg(r.ok, r.ok?'Default (PSU controlled).':r.output); refresh(); });
    } else if (p==='fixed'){
      // One click applies immediately, like the other presets: re-apply the last
      // fixed duty shown on the slider, and reveal the slider so it can be changed
      // (drag + Apply). No longer forces 100%.
      cfgMode='fixed'; setModeButtons('fixed'); fixedDirty=false;
      const d=document.getElementById('fixedSlider').value;
      post({action:'setfanmode',mode:'fixed',fixed:d}).then(r=>{ msg(r.ok, r.ok?('Fan set to '+d+'%.'):r.output); refresh(); });
    } else if (p==='customcurve'){
      // Reveal the draggable curve editor seeded with the current curve; the user
      // drags points and clicks "Apply Curve". Device shows "Custom curve" once applied.
      cfgMode='curve'; setModeButtons('curve'); drawCurve();
    } else {
      curvePts=parseCurve(PRESETS[p]); cfgMode='curve'; setModeButtons('curve'); drawCurve();
      post({action:'setfanmode',mode:'curve',curve:PRESETS[p]}).then(r=>{ msg(r.ok, r.ok?('Preset "'+p+'" applied.'):r.output); refresh(); });
    }
  };
});
document.getElementById('ocpSingle').onclick = ()=>
  post({action:'setocp',mode:'single'}).then(r=>{ msg(r.ok, r.ok?'OCP set to single rail.':r.output); refresh(); });
document.getElementById('ocpMulti').onclick = ()=>
  post({action:'setocp',mode:'multi'}).then(r=>{ msg(r.ok, r.ok?'OCP set to multi rail.':r.output); refresh(); });

document.getElementById('mainsAuto').onclick = ()=>
  post({action:'setmains',mains:'auto'}).then(r=>{ msg(r.ok, r.ok?'Mains voltage: Auto (read from PSU).':(r.output||'Failed.')); refresh(); });
document.getElementById('mains115').onclick = ()=>
  post({action:'setmains',mains:'115'}).then(r=>{ msg(r.ok, r.ok?'Mains voltage pinned to 115 V.':(r.output||'Failed.')); refresh(); });
document.getElementById('mains230').onclick = ()=>
  post({action:'setmains',mains:'230'}).then(r=>{ msg(r.ok, r.ok?'Mains voltage pinned to 230 V.':(r.output||'Failed.')); refresh(); });

// ---- energy usage + cost ----
function kwhFmt(v){ v = Number(v)||0; return v<10 ? v.toFixed(3) : (v<100 ? v.toFixed(2) : v.toFixed(1)); }
// format a cost with the chosen symbol + placement ("$1.23" vs "1.23 €")
function money(a){ const s = Number(a).toFixed(2); return lastPos==='after' ? (s+' '+lastCur) : (lastCur+s); }
function applyEnergy(e){
  if (!e) return;
  lastRate = e.rate || 0; lastCur = e.currency || '$'; lastPos = e.currency_pos || 'before';
  ETILES.forEach(t=>{
    const d = e[t.k] || {kwh:0, cost:0};
    document.getElementById('ek_'+t.k).textContent = kwhFmt(d.kwh);
    const ce = document.getElementById('ec_'+t.k);
    if (lastRate>0){ ce.textContent = money(d.cost); ce.parentElement.classList.remove('zero'); }
    else { ce.textContent = '—'; ce.parentElement.classList.add('zero'); }
  });
  document.getElementById('e_rate').textContent = money(lastRate);
  const since = e.since ? new Date(e.since*1000) : null;
  document.getElementById('e_since').textContent = since ? since.toLocaleDateString() : '--';
  histMonths = e.months || []; histYears = e.years || []; renderHist(); populatePickers();
  syncCurrencyControls();
}
function costCell(v){ return lastRate>0 ? money(v) : '—'; }
function renderHist(){
  const mtb = document.getElementById('histBodyM'); if (!mtb) return;
  const rows = histN>0 ? histMonths.slice(0, histN) : histMonths;
  mtb.innerHTML = rows.length ? rows.map(m=>
    `<div class="cpc-hrow"><span class="cpc-hc-label">${m.label}</span><span class="cpc-hc-num">${kwhFmt(m.kwh)} kWh</span><span class="cpc-hc-num cost">${costCell(m.cost)}</span></div>`).join('')
    : `<div class="cpc-hrow empty">No completed months yet — your first shows up after this month ends.</div>`;
  const ytb = document.getElementById('histBodyY');
  ytb.innerHTML = histYears.length ? histYears.map(y=>
    `<div class="cpc-hrow"><span class="cpc-hc-label">${y.year}</span><span class="cpc-hc-num">${kwhFmt(y.kwh)} kWh</span><span class="cpc-hc-num cost">${costCell(y.cost)}</span></div>`).join('')
    : `<div class="cpc-hrow empty">—</div>`;
}
document.querySelectorAll('#histFilter .cpc-btn').forEach(b=>{
  b.onclick = ()=>{
    document.querySelectorAll('#histFilter .cpc-btn').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    histN = parseInt(b.dataset.n, 10) || 0;
    renderHist();
  };
});

// ---- pick any specific month / year ----
function pickResHtml(kwh, cost){
  let h = '<span class="pk-k">'+kwhFmt(kwh)+' kWh</span>';
  if (lastRate>0) h += '<span class="pk-c">'+money(cost)+'</span>';
  return h;
}
function updateMonthPickRes(){
  const el = document.getElementById('monthPickRes'); if (!el) return;
  const m = histMonths.find(x=>x.ym===pickYm);
  el.innerHTML = m ? pickResHtml(m.kwh, m.cost) : '—';
}
function updateYearPickRes(){
  const el = document.getElementById('yearPickRes'); if (!el) return;
  const y = histYears.find(x=>String(x.year)===String(pickYear));
  el.innerHTML = y ? pickResHtml(y.kwh, y.cost) : '—';
}
function populatePickers(){
  const ms = document.getElementById('monthPick'), ys = document.getElementById('yearPick');
  if (!ms || !ys) return;
  if (pickYm===null   || !histMonths.some(m=>m.ym===pickYm))                pickYm   = histMonths.length ? histMonths[0].ym  : null;
  if (pickYear===null || !histYears.some(y=>String(y.year)===String(pickYear))) pickYear = histYears.length  ? histYears[0].year : null;
  // only rebuild the option lists when the set of months/years actually changes,
  // so a refresh never yanks an open dropdown shut - but keep the readouts live.
  const sig = histMonths.map(m=>m.ym).join(',') + '|' + histYears.map(y=>y.year).join(',');
  if (sig !== pickSig){
    ms.innerHTML = histMonths.length ? histMonths.map(m=>'<option value="'+m.ym+'">'+m.label+'</option>').join('') : '<option value="">— no data —</option>';
    ys.innerHTML = histYears.length  ? histYears.map(y=>'<option value="'+y.year+'">'+y.year+'</option>').join('')   : '<option value="">— no data —</option>';
    pickSig = sig;
  }
  if (pickYm!==null)   ms.value = pickYm;
  if (pickYear!==null) ys.value = pickYear;
  updateMonthPickRes(); updateYearPickRes();
}
document.getElementById('monthPick').onchange = e=>{ pickYm = e.target.value; updateMonthPickRes(); };
document.getElementById('yearPick').onchange  = e=>{ pickYear = e.target.value; updateYearPickRes(); };
function refreshEnergy(){ fetch(API+'?action=energy').then(r=>r.json()).then(applyEnergy).catch(()=>{}); }
document.getElementById('rateTile').onclick = ()=>{
  const inp = prompt('Electricity rate per kWh (number only, e.g. 0.15):', lastRate ? String(lastRate) : '');
  if (inp===null) return;
  const r = parseFloat(inp);
  if (isNaN(r) || r<0){ msg(false,'Enter a number like 0.15'); return; }
  post({action:'setrate', rate:r}).then(resp=>{
    if (resp && resp.ok){ applyEnergy(resp.energy); msg(true,'Electricity rate saved.'); }
    else msg(false,'Could not save the rate.');
  });
};
document.getElementById('resetTile').onclick = ()=>{
  if (!confirm('Reset all energy counters (today, week, month, year, lifetime) to zero? This cannot be undone.')) return;
  post({action:'resetenergy'}).then(resp=>{
    if (resp && resp.ok){ msg(true,'Energy counters reset.'); setTimeout(refreshEnergy,700); }
    else msg(false,'Reset failed.');
  });
};

// ---- currency (symbol + placement) ----
(function(){
  const sel = document.getElementById('curSelect');
  if (sel) sel.innerHTML = CURRENCIES.map(c=>'<option value="'+c.sym+'">'+c.label+'</option>').join('');
})();
function syncCurrencyControls(){
  const sel = document.getElementById('curSelect'); if (!sel) return;
  const custom = document.getElementById('curCustom');
  const preset = CURRENCIES.find(c=>c.sym===lastCur && c.sym!=='__custom__');
  if (preset){ sel.value = lastCur; custom.hidden = true; }
  else { sel.value = '__custom__'; custom.hidden = false; if (document.activeElement!==custom) custom.value = lastCur; }
  document.getElementById('curBefore').classList.toggle('active', lastPos!=='after');
  document.getElementById('curAfter').classList.toggle('active', lastPos==='after');
  document.getElementById('curPreview').textContent = money(0.15);
}
function applyCurrency(sym, pos){
  post({action:'setrate', currency:sym, currency_pos:pos}).then(resp=>{
    if (resp && resp.ok){ applyEnergy(resp.energy); msg(true,'Currency updated.'); }
    else msg(false,'Could not save currency.');
  });
}
document.getElementById('curSelect').onchange = e=>{
  const v = e.target.value;
  const custom = document.getElementById('curCustom');
  if (v==='__custom__'){ custom.hidden = false; custom.value=''; custom.focus(); return; }
  custom.hidden = true;
  const c = CURRENCIES.find(x=>x.sym===v);
  applyCurrency(c.sym, c.pos || lastPos);
};
document.getElementById('curCustom').onchange = e=>{
  const sym = (e.target.value||'').trim();
  if (sym) applyCurrency(sym, lastPos);
};
document.getElementById('curBefore').onclick = ()=> applyCurrency(lastCur, 'before');
document.getElementById('curAfter').onclick  = ()=> applyCurrency(lastCur, 'after');

// ---- text size (persisted per browser) ----
const app = document.getElementById('cpc');
let scale = parseFloat(localStorage.getItem('cpcScale') || '1');
function applyScale(){
  scale = Math.max(0.8, Math.min(2.0, Math.round(scale*100)/100));
  app.style.setProperty('--cpc-scale', scale);
  localStorage.setItem('cpcScale', scale);
}
document.getElementById('zIn').onclick  = ()=>{ scale += 0.1; applyScale(); };
document.getElementById('zOut').onclick = ()=>{ scale -= 0.1; applyScale(); };
document.getElementById('zRst').onclick = ()=>{ scale = 1;    applyScale(); };
applyScale();

refresh();
setInterval(refresh, 2000);
refreshEnergy();
setInterval(refreshEnergy, 10000);
})();
</script>
